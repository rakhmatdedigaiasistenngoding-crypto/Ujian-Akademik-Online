- `normalizeScore(raw, maxPossible)`: konversi ke skala 100
- `getBreakdown(answers, questions)`: breakdown per level (mudah/sedang/sulit)

##### [NEW] `frontend/src/types/exam.ts`
```typescript
type DifficultyLevel = 'easy' | 'medium' | 'hard';

interface Question {
  id: string;
  text: string;
  options: { key: string; text: string }[]; // A-E (5 opsi)
  correctAnswer: string;
  level: DifficultyLevel;
  weight: number; // mudah=2, sedang=3, sulit=4
  topic: string;
}

interface ExamSession {
  id: string;
  studentId: string;
  examId: string;
  questions: Question[];
  answers: (string | null)[];
  startedAt: Date;
  finishedAt: Date | null;
  deviceId: string;
  score: number | null;
}

interface ExamConfig {
  title: string;
  duration: number; // menit
  totalQuestions: number;
  distribution: Record<DifficultyLevel, number>;
  scoreRelease: 'immediate' | 'after_all' | 'scheduled';
  scoreReleaseAt?: Date;
}
```

